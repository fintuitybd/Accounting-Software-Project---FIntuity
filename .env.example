# Copy this file to .env for local development. Never commit .env.
# All values below are non-secret placeholders. Replace the password locally.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Local PostgreSQL. The password must match POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://ledgervault:replace-with-a-local-password@127.0.0.1:5432/ledgervault

LOG_LEVEL=info
TRUST_PROXY=false
DB_SSL=disable
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Browser origin used for same-origin mutation checks and one-time links.
APP_ORIGIN=http://localhost:5173

# Server-side session policy. Cookies are Secure automatically in production; override only for a
# deliberately terminated TLS proxy that terminates HTTPS before the API.
# COOKIE_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
SESSION_TOUCH_INTERVAL_SECONDS=60

# Authentication policy. Argon2id defaults follow OWASP guidance for a 19 MiB memory cost.
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
INVITATION_EXPIRY_HOURS=168
PASSWORD_RESET_EXPIRY_MINUTES=60
EMAIL_VERIFICATION_EXPIRY_HOURS=24
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Phase 3 email adapter. `file` writes messages to a git-ignored local outbox and is for
# development only. A production SMTP/provider adapter is an external go-live blocker; do not
# mistake the local outbox for delivery.
EMAIL_TRANSPORT=file
EMAIL_OUTBOX_DIR=.tmp/mail
EMAIL_FROM=Fintuity Accounting Suite <no-reply@fintuity.local>

# Docker Compose uses this to initialise the local PostgreSQL container.
# Use a URL-safe value or percent-encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-local-password

# Vite frontend. Set VITE_DEMO_MODE=true only for the isolated synthetic demo; leave false for
# authenticated server-backed use.
VITE_DEMO_MODE=false
VITE_API_BASE_URL=/api/v1
# Canonical public origin used by the landing page's canonical, Open Graph and JSON-LD metadata.
# Production builds must set the real HTTPS origin; the localhost value is for development only.
VITE_PUBLIC_SITE_URL=http://localhost:5173
