{
  "name": "ledgervault",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "npm run build --workspace @ledgervault/server",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:app && npm run typecheck:server",
    "typecheck:app": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:server": "npm run typecheck --workspace @ledgervault/server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "npm run test --workspace @ledgervault/server",
    "test:server:integration": "npm run test:integration --workspace @ledgervault/server",
    "server:dev": "npm run dev --workspace @ledgervault/server",
    "server:start": "npm run start --workspace @ledgervault/server",
    "auth:bootstrap": "npm run auth:bootstrap --workspace @ledgervault/server --",
    "migrate": "npm run migrate --workspace @ledgervault/server",
    "migrate:down": "npm run migrate:down --workspace @ledgervault/server --",
    "migrate:status": "npm run migrate:status --workspace @ledgervault/server",
    "db:reset:dev": "npm run db:reset:dev --workspace @ledgervault/server --",
    "taxpack:generate": "esbuild scripts/generate-server-tax-pack.ts --bundle --platform=node --format=cjs --outfile=.tmp/generate-server-tax-pack.cjs && node .tmp/generate-server-tax-pack.cjs && prettier --write server/src/sales/taxPack.generated.ts server/src/purchases/taxPack.generated.ts",
    "selfcheck": "npm run selfcheck:core && npm run selfcheck:actions && npm run selfcheck:import && npm run selfcheck:gate",
    "selfcheck:core": "esbuild scripts/selfcheck.ts --bundle --platform=node --format=cjs --outfile=.tmp/selfcheck.cjs && node .tmp/selfcheck.cjs",
    "selfcheck:actions": "esbuild scripts/selfcheck-actions.ts --bundle --platform=node --format=cjs --outfile=.tmp/selfcheck-actions.cjs && node .tmp/selfcheck-actions.cjs",
    "selfcheck:import": "esbuild scripts/selfcheck-import.ts --bundle --platform=node --format=cjs --outfile=.tmp/selfcheck-import.cjs && node .tmp/selfcheck-import.cjs",
    "selfcheck:gate": "esbuild scripts/gate.ts --bundle --platform=node --format=cjs --outfile=.tmp/gate.cjs && node .tmp/gate.cjs",
    "selfcheck:render": "esbuild scripts/smoke-render.ts --bundle --platform=node --format=cjs --outfile=.tmp/smoke-render.cjs && node .tmp/smoke-render.cjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:built-security": "node scripts/check-built-security.mjs",
    "drill:backup-restore": "node scripts/backup-restore-drill.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "postcss": "^8.4.49",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.72.1",
    "vite": "^5.4.10",
    "vitest": "3.2.7"
  }
}
